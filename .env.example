PORT=3000
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# Every Nth successfully placed order unlocks one coupon worth X percent off.
# 1 makes every order unlock a reward, which is quickest to try; the assignment's example is 5.
REWARD_EVERY_N_ORDERS=1
REWARD_DISCOUNT_PERCENT=10
# true: an order that reaches a milestone creates its reward at once. false (the default when
# unset): rewards are only created when an administrator calls POST /admin/coupons.
REWARD_AUTO_GENERATE=true
