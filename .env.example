PORT=3000
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# Every Nth successfully placed order unlocks one coupon worth X percent off.
REWARD_EVERY_N_ORDERS=5
REWARD_DISCOUNT_PERCENT=10
# false (the assignment's behaviour): rewards are created only when an administrator calls
# POST /admin/coupons. true: an order that reaches a milestone creates its reward at once.
# For a quick try, set REWARD_EVERY_N_ORDERS=1 and REWARD_AUTO_GENERATE=true (what `make demo` does).
REWARD_AUTO_GENERATE=false
